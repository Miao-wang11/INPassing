# ==========================================
# 小i跑腿 — Docker 环境变量
# ==========================================
# 复制此文件为 .env 并按需修改
#   cp .env.example .env
# ==========================================

# MySQL root 密码（首次初始化后修改无效）
MYSQL_ROOT_PASSWORD=replace-with-a-strong-local-password

# 宿主机端口映射（避免与本地服务冲突）
MYSQL_PORT=3308
REDIS_PORT=6381
BACKEND_PORT=8080
NGINX_PORT=80

# JWT 签名密钥（生产环境务必修改为强随机字符串，长度 ≥ 32）
JWT_ADMIN_SECRET=replace-with-random-32-plus-character-admin-secret
JWT_USER_SECRET=replace-with-random-32-plus-character-user-secret

# Platform admin password (MUST change before first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password

# Only local demo: creates testuser / testuser2 (password 123456)
# Never turn this on for any publicly accessible deployment.
SHUNSHOU_DEMO_SEED=false

# ---- 外部服务（Docker 本地测试可留空） ----
# 阿里云 AccessKey（OSS + SMS）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 微信小程序
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 腾讯地图
TENCENT_MAP_API_KEY=

# Agent Java<->Python internal shared key: generate a new random value
# python -c "import secrets; print(secrets.token_hex(32))"
# Never use a placeholder on a publicly reachable server.
SHUNSHOU_AI_INTERNAL_TOKEN=
# Local demo can run deterministic mock model; production MUST use a real provider.
SHUNSHOU_AI_ENVIRONMENT=development
SHUNSHOU_AI_MODEL_PROVIDER=mock
SHUNSHOU_AI_MODEL_NAME=gpt-4.1-mini
SHUNSHOU_AI_MODEL_BASE_URL=
SHUNSHOU_AI_MODEL_API_KEY=
